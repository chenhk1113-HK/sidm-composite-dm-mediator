    "l_max": 3,
    "de_broglie_wavelength_fm_at_v_target": 4027.0,
    "m_A_prime_keV_required_for_resonance": 50.0,
    "velocity_conversion_fix": "ClawsGO #8: was sqrt(2*mu*E)*c with c=2.998e7 km/s; now sqrt(2*E/mu)*c with c=2.998e5 km/s (correct non-relativistic). Ratio of original/correct: 50.0 (clawsgo confirmed).",
    "commit_at_phase3": "v19.2-F Phase 3 (CORRECTED)"
