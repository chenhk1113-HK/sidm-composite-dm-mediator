# --- Project-specific: outputs/ is shipping-only noise ---
# outputs/ contains one-shot Telegram-shipped PDFs/ZIPs from each release
# round (D2 through D15-CORRECTED3). These are reproducible from the
# code in v0.*-prelim/code/, so they don't belong in version control.
# The build_*.py / append_*.py / apply_*.py scaffolding scripts that
# generated them are also regenerated on demand, so ignore them too.
# If you actually want to ship the latest PDFs, regenerate via the
# build_<round>_pdf.py scripts (they live in the same dir, gitignored).
outputs/

# --- WSL / sync artefacts ---
/home/lamkuenai/dm-sidm-pipeline/    # legacy WSL mirror (renamed)

# --- Large data files (not source) ---
*.h5
*.hdf5
*.fits
*.npz
*.npy
# Keep .json (used for results) but exclude raw data dumps:
data/raw/
v0.*-prelim/data/raw/
v0.*-prelim/data/external_data/lz_2024/raw/
v0.*-prelim/data/external/
# T90.25 PandaX public response bundle: keep the small ROOT + xlsx inputs
# (~113 KB total) so the fold is reproducible without re-downloading.
!v0.*-prelim/data/external_data/pandax_4t/
!v0.*-prelim/data/external_data/pandax_4t/response/
!v0.*-prelim/data/external_data/pandax_4t/response/eff_RDQ_graph.root
!v0.*-prelim/data/external_data/pandax_4t/response/PandaX4T_Data_ne.xlsx
# Keep the unzipped public candidate CSVs (small, versionable); the source
# opendata.tar.gz / open-data.tar.gz are redundant archives and are excluded.
v0.*-prelim/data/external_data/*/opendata.tar.gz
v0.*-prelim/data/external_data/*/open-data.tar.gz
v0.*-prelim/data/external_data/*/s2only_data_release.zip

# --- Reference posterior samples (R13 M2 fix) ---
# data/reference/ contains downsampled posterior chains (~314 KB total)
# committed so users can plot headline posteriors without re-running
# dynesty (~3 min wall on WIMpy wimpy per the T41 fit). Source samples
# stay gitignored.
!data/reference/
!data/reference/*.npz

# External data products (e.g. McDaniel+ 2024 Fermi dSph TS profiles).
# Re-download via outputs/fetch_external_data.sh

