# DISABLED by owner decision D12 on 2026-11-08. GitHub only picks up workflows whose
# filename ends in .yml/.yaml, so renaming this file to .disabled switches the workflow
# off without deleting it.
#
# Why it was switched off instead of left running:
#   1. It has been red continuously since 2026-10-11. Census read from the public API
#      on 2026-11-08 (runs 244/245, both triggered by a push): the Python 3.11 job fails
#      at "Install dependencies", the 3.12 job installs and fails at "Run pytest", the
#      `pre-commit py_compile` job passes, and the three audit steps below (claims, t82,
#      drift guard) are never reached. The failure messages are unreadable
#      unauthenticated (HTTP 403 on run logs), so the badge cannot even explain itself.
#   2. Even a green run would certify less than the local gate: this file still lists 15
#      `--ignore` test files, while `scripts/verify_release_gate.py` now has an EMPTY
#      `GATE_IGNORED_TESTS` (decision D9 round 2 re-admitted the T120 family on
#      2026-11-06). The two test populations have drifted apart.
#   3. A permanently red badge teaches readers to ignore badges (the CG-11 anti-pattern).
#
# This does not reduce verification. The release evidence for every round is the local
# 15-layer `scripts/verify_release_gate.py` run (15/15 PASS on 4a2ffdc, 2026-11-08:
# 3642 passed / 25 skipped / 40 deselected, t82 120/120). A GitHub-side mark says nothing
# about the physics in either direction.
#
# To re-enable: `git mv .github/workflows/ci.yml.disabled .github/workflows/ci.yml`,
# after (a) finding why the 3.11 arm cannot install `requirements-ci.txt` and (b)
# replacing the 15 `--ignore` lines with the gate's current exclusion map.

name: CI

# 2026-11-03 fix. Before this, CI had been red since 2026-10-11 and had never
# executed a single test: `cache-dependency-path: v0.3-prelim/requirements.txt`
# named a file that exists on no branch, so actions/setup-python failed at its
# cache-lookup step in both matrix arms and every step after it (pytest, t82)
# was skipped. The following `pip install -e v0.3-prelim/` could not have
# succeeded either - v0.3-prelim/ has no setup.py, pyproject.toml or setup.cfg,
# so it is not an installable package. Only the py_compile lint job ever passed.
# The triggers now include the active development branch, which no workflow used
# to fire on: that branch had zero check-runs.

on:
  push:
    branches: [master, wip/v19.2-F-init]
  pull_request:
    branches: [master, wip/v19.2-F-init]
  workflow_dispatch:

jobs:
  test:
    name: pytest + audits (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.11", "3.12"]

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
          cache-dependency-path: |
            requirements-ci.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-ci.txt
          # No `pip install -e`: v0.3-prelim/ is not a package. Import paths for
          # v0.3-prelim/code and scripts/ are set by v0.3-prelim/tests/conftest.py.

      - name: Run pytest (same exclusions as scripts/verify_release_gate.py)
        # The 15 --ignore exclusions and the -k filter are copied from the gate's
        # pytest layer, so CI runs the same test population the local gate certifies.
        #
        # The 39 --deselect entries are NOT known-broken tests. All 39 pass locally,
        # and all 39 were re-verified as PASSING on 2026-11-03 with the local bench
        # venv. They need resources a fresh checkout cannot have:
        #   (W) 36 exercise Channel 26 (magnetic moment), which imports WIMpy
        #       (bradkav/WIMpy_NREFT). That package is not on PyPI: the working copy
        #       is a VCS install pinned to git commit 50581c6 and built against this
        #       host's scipy. Without it the channel returns 0 by design, so its
        #       log-likelihood assertions cannot hold.
        #   (D) 3 read machine-local inputs that .gitignore deliberately keeps out of
        #       the repository: v0.3-prelim/data/external/ (595 files, 16 MB) and the
        #       verified paper PDFs under docs/papers/verified/.
        # Deselection is disclosed, not hidden: CI certifies 1915 of the 1954 tests
        # the local gate certifies and names the 39 it cannot. The repo-side fix
        # (vendor the data, or install WIMpy from its git source in CI) is an open
        # decision, tracked with coverage gap CG-16.
        run: |
          python -m pytest v0.3-prelim/tests/ -q --tb=short \
            --ignore=v0.3-prelim/tests/test_sparc_hierarchical.py \
            --ignore=v0.3-prelim/tests/test_t32_real_likelihood.py \
            --ignore=v0.3-prelim/tests/test_phase42_summary.py \
            --ignore=v0.3-prelim/tests/test_phase46_three_items.py \
            --ignore=v0.3-prelim/tests/test_phase47_50.py \
            --ignore=v0.3-prelim/tests/test_t120_4_joint_fit.py \
            --ignore=v0.3-prelim/tests/test_t120_11_hidden_u1.py \
            --ignore=v0.3-prelim/tests/test_t120_13_integration.py \
            --ignore=v0.3-prelim/tests/test_t120_15_uv_slope.py \
            --ignore=v0.3-prelim/tests/test_t87_inelastic_nucleon.py \
            --ignore=v0.3-prelim/tests/test_t90_v60_naturalness.py \
            --ignore=v0.3-prelim/tests/test_t82_audit_version_drift.py \
            --ignore=v0.3-prelim/tests/test_phase7e_unit_conversion_audit.py \
            --ignore=v0.3-prelim/tests/test_config_split_brain.py \
            --ignore=v0.3-prelim/tests/test_paper_v19_regression.py \
            -k "not T132 and not T131 and not T133 and not T134 and not T135 and not T220" \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_binned_loglike_in_realistic_range \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_lz_best_fit_mass_preferred \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_mu_n_to_mu_b_conversion \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_overprediction_penalty \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_project_map_mass_also_preferred \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_t41_with_t90_active \
          --deselect=v0.3-prelim/tests/test_lz_magnetic_moment.py::test_underprediction_penalty \
          --deselect=v0.3-prelim/tests/test_phase33d_real_sparc.py::TestPhase33d::test_sparc_table_downloaded \
          --deselect=v0.3-prelim/tests/test_phase7d_t95_stream.py::test_phase7d_runs_as_script \
          --deselect=v0.3-prelim/tests/test_t116_sequential_t90_value.py::TestPredictLZ::test_n_pred_at_t90_value \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_exposure_scaling \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_mu_x_squared_scaling \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_published_limit_ratio_consistency \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_verdict_at_or_above_limit_for_darwin \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_verdict_much_below_limit \
          --deselect=v0.3-prelim/tests/test_t90_v10_cross_detector.py::test_verdict_near_limit \
          --deselect=v0.3-prelim/tests/test_t90_v11_v12_v13.py::test_magnetic_dipole_baseline \
          --deselect=v0.3-prelim/tests/test_t90_v11_v12_v13.py::test_other_operators_smaller_than_magnetic \
          --deselect=v0.3-prelim/tests/test_t90_v14_calibrated.py::test_all_operators_have_different_predictions \
          --deselect=v0.3-prelim/tests/test_t90_v14_calibrated.py::test_calibration_produces_target_n_events \
          --deselect=v0.3-prelim/tests/test_t90_v14_calibrated.py::test_coupling_squared_scaling \
          --deselect=v0.3-prelim/tests/test_t90_v14_calibrated.py::test_magnetic_dipole_matches_lz_tuned \
          --deselect=v0.3-prelim/tests/test_t90_v14_calibrated.py::test_millicharge_largest_cross_detector \
          --deselect=v0.3-prelim/tests/test_t90_v23_dry_run.py::test_path1_dry_run_emits_json \
          --deselect=v0.3-prelim/tests/test_t90_v23_dry_run.py::test_path1_yaml_loader_parses_real_file \
          --deselect=v0.3-prelim/tests/test_t90_v24_pandax_fold.py::test_folded_signal_is_below_raw_signal \
          --deselect=v0.3-prelim/tests/test_t90_v24_pandax_fold.py::test_live_fold_has_auditable_counts \
          --deselect=v0.3-prelim/tests/test_t90_v25_pandax_efficiency_background_fold.py::test_public_efficiency_has_nontrivial_shape \
          --deselect=v0.3-prelim/tests/test_t90_v25_pandax_efficiency_background_fold.py::test_root_graph_is_real_and_bounded \
          --deselect=v0.3-prelim/tests/test_t90_v25_pandax_efficiency_background_fold.py::test_run_separated_fold_is_auditable \
          --deselect=v0.3-prelim/tests/test_t90_v25_pandax_public_response.py::test_efficiency_graph_is_loaded_from_public_file \
          --deselect=v0.3-prelim/tests/test_t90_v25_pandax_public_response.py::test_proxy_is_bounded_and_non_decreasing \
          --deselect=v0.3-prelim/tests/test_t90_v26_pandax_event_scorecard.py::test_model_prediction_is_separate_from_event_rows \
          --deselect=v0.3-prelim/tests/test_t95_v11_gaia_cross_match.py::test_get_stream_center_works_for_alpheus \
          --deselect=v0.3-prelim/tests/test_t95_v12_gmm_cross_match.py::test_gmm_emits_required_fields \
          --deselect=v0.3-prelim/tests/test_t95_v12_gmm_cross_match.py::test_gmm_honest_disclaimer_in_docstring \
          --deselect=v0.3-prelim/tests/test_t95_v12_gmm_cross_match.py::test_gmm_runs_without_exception \
          --deselect=v0.3-prelim/tests/test_t95_v14_chemodynamic.py::test_pmgm_module_importable \
          --deselect=v0.3-prelim/tests/test_v40_61_n14_docx_response.py::test_ohana_paper_saved_locally
      - name: Run claim audit
        run: python scripts/audit_claims.py

      - name: Run stale-claim audit (t82)
        run: python scripts/t82_audit.py

      - name: Run numerical drift guard
        run: python scripts/drift_guard.py --strict

  lint:
    name: pre-commit py_compile
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: py_compile all Python source files
        # Mirrors the project's pre-commit hook (.githooks/pre-commit): py_compile
        # every .py under v0.3-prelim/, failing on SyntaxError or SyntaxWarning.
        # This job needs no dependencies, so it installs none.
        run: |
          python -c "
          import py_compile, sys, pathlib, warnings
          warnings.simplefilter('error', SyntaxWarning)
          root = pathlib.Path('v0.3-prelim')
          files = list(root.rglob('*.py'))
          errors = 0
          for f in files:
              if '__pycache__' in str(f): continue
              try:
                  py_compile.compile(str(f), doraise=True)
              except (py_compile.PyCompileError, SyntaxWarning) as e:
                  print(f'FAIL: {f}: {e}')
                  errors += 1
          sys.exit(1 if errors else 0)
          "
